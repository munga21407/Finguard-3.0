# Top-level quick reference only — this file is not read by any service.
# Each service loads its own .env from its own directory:
#   cp backend/.env.example        backend/.env
#   cp frontend/.env.local.example frontend/.env.local
#   cp infrastructure/.env.example infrastructure/.env   # optional, compose overrides
#
# The variables below are the ones you're most likely to need for a first
# local run. See each file above for the full, documented list.

# --- Backend (backend/.env) ---
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-strong-random-secret-key
ALLOWED_ORIGINS=["http://localhost:3000"]
APP_BASE_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://finguard:finguard@localhost:5432/finguard
MONGODB_URL=mongodb://finguard:finguard@localhost:27017
REDIS_URL=redis://:finguard@localhost:6379/0
RABBITMQ_URL=amqp://finguard:finguard@localhost:5672/

# AI — Fireworks AI (OpenAI-compatible)
FIREWORKS_API_KEY=fw_...
LLM_MODEL=accounts/<account>/deployments/<id>

# --- Frontend (frontend/.env.local) ---
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Infrastructure (infrastructure/.env) ---
# Optional feature-flag overrides for docker-compose*.yml, all default false:
# A2A_PLANNER_ENABLED=true
# TASK_VC_ENFORCEMENT_ENABLED=true
# LANGGRAPH_CHECKPOINTING_ENABLED=true
