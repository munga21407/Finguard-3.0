# Optional overrides for infrastructure/docker-compose*.yml. Copy to .env in
# this directory (gitignored) to change values `docker compose up` picks up —
# everything else already has a safe default baked into the compose files.
#
# Feature flags (all default false — see backend/src/core/config.py):
#   A2A_PLANNER_ENABLED=true
#   TASK_VC_ENFORCEMENT_ENABLED=true
#   LANGGRAPH_CHECKPOINTING_ENABLED=true
