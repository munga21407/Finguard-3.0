# Application
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-me-to-a-strong-random-secret-key
ALLOWED_ORIGINS=["http://localhost:3000"]
# One-time secret that must be sent in the registration payload (bootstrap_key)
# to claim the first OWNER account. Required (>=32 chars) in production; when
# blank outside production the first account becomes OWNER automatically.
INITIAL_BOOTSTRAP_KEY=

# Initial superuser (OWNER) + ADMIN accounts seeded by `python -m scripts.seed_users`
# (or `make seed-users`). Lets you log in on a fresh deploy without registering.
# Idempotent — existing emails are left untouched. Leave an email blank to skip
# that role. In production the seeder refuses weak/placeholder passwords (>=12 chars).
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
SEED_OWNER_NAME=Finguard Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Finguard Admin

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://finguard:finguard@localhost:5432/finguard
POSTGRES_USER=finguard
POSTGRES_PASSWORD=finguard
POSTGRES_DB=finguard

# MongoDB
MONGODB_URL=mongodb://finguard:finguard@localhost:27017
MONGODB_DB=finguard

# Redis
REDIS_URL=redis://:finguard@localhost:6379/0
AUTH_REDIS_URL=redis://:finguard@localhost:6379/1
RATE_LIMIT_REDIS_URL=redis://:finguard@localhost:6379/2
REDIS_PASSWORD=finguard

# RabbitMQ
RABBITMQ_URL=amqp://finguard:finguard@localhost:5672/

# Background workers (enabled by default; set to false to disable in lightweight environments)
ENABLE_EXPENSE_EVENT_CONSUMER=true
ENABLE_OUTBOX_PROJECTOR=true
OUTBOX_POLL_INTERVAL=5.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_RETRIES=5
RABBITMQ_CONSUMER_RETRY_SECONDS=5
WATCHDOG_CONSUMER_INTERVAL_SECONDS=30

# Celery
CELERY_BROKER_URL=amqp://finguard:finguard@localhost:5672/
CELERY_RESULT_BACKEND=redis://:finguard@localhost:6379/1

# JWT / Auth
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30
PASSWORD_MIN_LENGTH=8

# AI — Fireworks AI (OpenAI-compatible). Gemma 4 generation + nomic embeddings.
FIREWORKS_API_KEY=fw_...
LLM_API_BASE=https://api.fireworks.ai/inference/v1
# One multimodal deployment serves both text/structured and vision (OCR) paths.
LLM_MODEL=accounts/<account>/deployments/<id>
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=768
# Per-agent LLM cost metric is model-keyed via LLM_PRICING_JSON (see
# src/domains/intelligence/llm/pricing.py); leave unset to use built-in defaults.
# LLM_PRICING_JSON={"accounts/<account>/deployments/<id>":{"input":0.0,"output":0.0}}

# External Integrations (Agent I)
# Leave blank to run in mock mode (safe for local dev).
# Provide real credentials to enable live data from Kenyan financial APIs.
# M-Pesa Daraja SANDBOX — free self-service keys at developer.safaricom.co.ke
MPESA_CONSUMER_KEY=your_mpesa_consumer_key_here
MPESA_CONSUMER_SECRET=your_mpesa_consumer_secret_here
MPESA_SHORTCODE=your_mpesa_shortcode_here
# Inbound STK callback authentication. Safaricom does NOT sign callbacks, so set
# this to Safaricom's published callback IP ranges (CIDRs, comma-separated, e.g.
# ["196.201.214.0/24","196.201.213.0/24"]). When set, callbacks from any other
# origin are rejected. If left empty, MPESA_CONSUMER_SECRET HMAC signing becomes
# the sole control; with neither set the callback endpoint fails closed (503).
MPESA_CALLBACK_ALLOWED_IPS=[]
# FX rates: free, keyless public provider (USD-based → KES cross-rates). Override
# to any equivalent source. CBK has no public developer FX API.
FX_API_URL=https://open.er-api.com/v6/latest/USD
# Metropol (credit) and KRA (VAT) are deferred — leave blank. When unset, Agent I
# reports them as "unavailable" (never fabricated); operators may supply values
# manually via context["manual_credit_score"] / context["manual_kra_status"].
METROPOL_API_KEY=
KRA_ECITIZEN_API_KEY=

# Observability — Bearer token for the /metrics Prometheus scrape endpoint.
# Leave empty to disable auth (development only; must be set in production).
METRICS_AUTH_SECRET=your_strong_metrics_bearer_token_here

# PostgreSQL read-only role (for Text-to-SQL engine — see infrastructure/db_security.sql)
# Create the role first: docker compose exec postgres psql -U finguard -d finguard -f infrastructure/db_security.sql
# Without this, Agent D's CoVe queries run against the fully-privileged main engine (SECURITY RISK).
DATABASE_READONLY_URL=postgresql+asyncpg://finguard_readonly:your_readonly_password_here@localhost:5432/finguard
